\PYG{c+cp}{\PYGZsh{}}\PYG{c+cp}{define cl const line \PYGZam{}               }\PYG{c+c1}{// 只读直线引用}
\PYG{c+cp}{\PYGZsh{}}\PYG{c+cp}{define cc const circle \PYGZam{}             }\PYG{c+c1}{// 只读圆引用}
\PYG{c+cp}{\PYGZsh{}}\PYG{c+cp}{define vp std::vector\PYGZlt{}point\PYGZgt{}         }\PYG{c+c1}{// 点集}
\PYG{c+cp}{\PYGZsh{}}\PYG{c+cp}{define cvp const std::vector\PYGZlt{}point\PYGZgt{} \PYGZam{} }\PYG{c+c1}{// 只读点集引用}
