\PYG{c+c1}{// ==================== atan2 ====================}
\PYG{c+c1}{// std::atan2(y, x)}
\PYG{c+c1}{// 返回向量 (x, y) 相对 x 轴正方向的有向极角。}
\PYG{c+c1}{// 注意参数顺序是 atan2(y, x)，不是 atan2(x, y)！}
\PYG{c+c1}{// 返回范围通常为 [\PYGZhy{}pi, pi]（边界细节涉及 ±0）。}
\PYG{c+c1}{// x == 0 时仍能正常使用；(0, 0) 的方向没有几何意义。}

\PYG{c+c1}{// ==================== acos ====================}
\PYG{c+c1}{// std::acos(x)}
\PYG{c+c1}{// 计算 arccos(x)。}
\PYG{c+c1}{// 定义域：x in [\PYGZhy{}1, 1]}
\PYG{c+c1}{// 返回范围：[0, pi]}
\PYG{c+c1}{// const long double PI = std::acos(\PYGZhy{}1.0L);}
\PYG{c+c1}{// 浮点误差可能使 cos\PYGZus{}theta 略超 [\PYGZhy{}1, 1]，必须 clamp：}
\PYG{c+c1}{// cos\PYGZus{}theta = std::clamp(cos\PYGZus{}theta, \PYGZhy{}1.0L, 1.0L);}
\PYG{c+c1}{// theta = std::acos(cos\PYGZus{}theta);}
\PYG{c+c1}{// std::clamp(x, l, r)：把 x 限制在闭区间 [l, r]。}
\PYG{c+c1}{// if (x \PYGZlt{} l) return l;}
\PYG{c+c1}{// if (x \PYGZgt{} r) return r;}
\PYG{c+c1}{// return x;}
